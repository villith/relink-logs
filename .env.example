# Copy to .env and point at the logs.db you want to inspect. Used by
# scripts/log-size-report.mjs; .env is gitignored because this path is
# per-machine.
#
# The app writes logs.db next to the binary that ran, so it is typically one of:
#   src-tauri/logs.db                         (npm run tauri dev)
#   src-tauri/target/release/logs.db          (a local release build)
#   C:/Program Files/Relink Logs/logs.db      (an installed build)
#
# Forward slashes are fine on Windows. Quotes are optional.
RELINK_LOGS_DB=src-tauri/logs.db
